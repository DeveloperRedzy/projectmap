# Secrets for the send-invite Edge Function.
# Local dev: copy to `supabase/functions/.env` (gitignored) OR leave BREVO_API_KEY
#   unset to run in DEV MODE (logs + returns the invite link instead of emailing).
# Production: set via `supabase secrets set --env-file ...` (never commit real keys).
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the runtime.

# Brevo transactional email API key. If unset -> dev mode (no real email sent).
BREVO_API_KEY=

# Verified sender (Brevo single-sender or domain). Free tier: a sender you own.
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=ProjectMap

# Public base URL of the deployed frontend; invite links point at
# `${SITE_URL}/accept-invite?token=...`. Defaults to http://127.0.0.1:3000 in dev.
SITE_URL=https://your-app.vercel.app
